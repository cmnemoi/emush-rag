#!/bin/sh
# Scrape the wikis and index them into the production OpenSearch through an SSH tunnel.
# The API keeps serving the previous index until the new one is complete.
#
# Usage: scripts/index-production-documents [ssh options...] <destination>
#   From a workstation: scripts/index-production-documents cmnemoi.production
#   From the CI:        scripts/index-production-documents -p 49512 -i key askneron@host
set -eu

if [ "$#" -eq 0 ]; then
    echo "Usage: $0 [ssh options...] <destination>" >&2
    exit 1
fi

# The server publishes OpenSearch on its loopback only, on the port assigned to askneron by my-vps.
SERVER_PORT=8162
LOCAL_PORT=19200
CONTROL_SOCKET="$(mktemp -u)"
# Scraped outside of data/, which only holds an extract of the wikis for local development.
SCRAPED_DIR="$(mktemp -d)"

uv run --group indexation mush-wikis-scrap > "$SCRAPED_DIR/wikis.json"

ssh -M -S "$CONTROL_SOCKET" -fN -o ExitOnForwardFailure=yes -L "$LOCAL_PORT:127.0.0.1:$SERVER_PORT" "$@"
trap 'ssh -S "$CONTROL_SOCKET" -O exit "$@" 2>/dev/null; rm -rf "$SCRAPED_DIR"' EXIT

uv run emush_rag/cli/index_documents.py \
    --data-dir "$SCRAPED_DIR" --vector-store-url localhost --vector-store-port "$LOCAL_PORT"
